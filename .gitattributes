# Les fichiers lus par Linux gardent des fins de ligne Unix, même
# créés sous Windows : un script en CRLF est refusé par le noyau
# avec « bad interpreter ».
* text=auto

*.sh    text eol=lf
Dockerfile text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf

*.bat   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
